{
  "comments": {
    "blockComment": [
      "<!--",
      "-->"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*<!--\\s*#?region\\b",
      "end": "^\\s*<!--\\s*#?endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "<(?!\\!|/)([A-Za-z][\\w:.-]*)(?:\\s[^<>]*)?(?<!/)>(?!.*</\\1\\s*>)\\s*$|\\{[^}]*$",
    "decreaseIndentPattern": "^\\s*(</[^>]+>|[}\\]])"
  }
}
