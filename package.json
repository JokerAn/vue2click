{
  "name": "vueClick",
  "displayName": "vueClick",
  "description": "独立 Vue 2 编辑支持：高亮、跳转、类型补全、悬停、引用与重命名",
  "icon": "icon.png",
  "version": "0.22.0",
  "publisher": "jokeran",
  "author": "jokeran",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JokerAn/vue2click.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:vue",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vueClick.checkCurrentFile",
        "title": "VueClick: 检查当前文件"
      },
      {
        "command": "vueClick.restartLanguageService",
        "title": "VueClick: 重启语言服务"
      },
      {
        "command": "vueClick.showProjectInfo",
        "title": "VueClick: 查看项目与服务状态"
      }
    ],
    "languages": [
      {
        "id": "vue",
        "aliases": [
          "Vue",
          "vue"
        ],
        "extensions": [
          ".vue"
        ],
        "configuration": "./languages/vue-language-configuration.json"
      },
      {
        "id": "vueclick-html",
        "aliases": [
          "VueClick HTML"
        ],
        "configuration": "./languages/vue-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vue",
        "scopeName": "source.vue",
        "path": "./syntaxes/vue.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.vueclick": "vueclick-html",
          "source.js": "javascript",
          "source.js.jsx": "javascriptreact",
          "source.ts": "typescript",
          "source.tsx": "typescriptreact",
          "source.css": "css",
          "source.css.scss": "scss",
          "source.css.less": "less",
          "text.pug": "jade",
          "source.directive.vue": "javascript",
          "expression.embedded.vue": "javascript",
          "source.sass": "sass",
          "source.stylus": "stylus"
        },
        "tokenTypes": {
          "source.directive.vue": "other",
          "expression.embedded.vue": "other"
        }
      },
      {
        "language": "vueclick-html",
        "scopeName": "text.html.vueclick",
        "path": "./syntaxes/vue-html.tmLanguage.json",
        "embeddedLanguages": {
          "source.directive.vue": "javascript",
          "expression.embedded.vue": "javascript"
        }
      }
    ],
    "configuration": {
      "title": "VueClick",
      "properties": {
        "vueClick.autoClosingTags.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "输入模板标签时补全闭合标签，尊重 html.autoClosingTags 设置。"
        },
        "vueClick.formatting.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "提供整份 Vue 文件的模板、脚本和样式格式化；可关闭以交给 Prettier 等格式器。"
        },
        "vueClick.languageService.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "启用独立工作线程中的 Vue/TypeScript 语言服务，提供类型补全、悬停、参数、引用和语义重命名。"
        },
        "vueClick.diagnostics.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "自动显示 Vue 脚本、模板成员、缺失资源及 CSS/SCSS/Less 诊断；启用后会在活动 Vue 文档打开或编辑后分析项目。"
        },
        "vueClick.diagnostics.staticChecks": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "在诊断中包含模板成员与缺失资源检查；关闭后只保留脚本和样式诊断。"
        },
        "vueClick.definition.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "提供 VueClick 定义跳转。"
        },
        "vueClick.completion.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "提供 Vue 成员、组件、props 及语言服务的类型补全与自动导入。"
        },
        "vueClick.snippets.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "在 Vue 文件的相应位置提供 Vue 2 组件、选项和模板指令片段。"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:vscode": "node scripts/test-vscode.js",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:registry": "node scripts/benchmark-registry.js",
    "benchmark:file": "node scripts/benchmark-file.js",
    "build": "node scripts/build.js && node scripts/check-bundle.js && node scripts/check-worker.js",
    "package": "npm run test && npm run build && vsce package --no-dependencies",
    "release": "npm run test && npm run build && vsce publish --no-dependencies",
    "publish:vsix": "vsce publish --no-dependencies --packagePath"
  },
  "devDependencies": {
    "@volar/typescript": "2.4.23",
    "@vscode/emmet-helper": "2.11.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "^3.6.0",
    "@vue/compiler-dom": "^3.5.43",
    "@vue/language-core": "3.0.11",
    "@vue/shared": "^3.5.43",
    "entities": "^7.0.1",
    "esbuild": "^0.25.0",
    "ignore": "7.0.10",
    "typescript": "~5.9.0",
    "vscode-css-languageservice": "6.3.10",
    "vscode-html-languageservice": "5.6.2",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0",
    "vue": "2.7.16"
  }
}
